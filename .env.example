# Copia este archivo como .env.local para desarrollo. NUNCA pongas secretos aquí:
# todo lo que empieza por VITE_ termina dentro del JavaScript público del navegador.

# Fuente de datos: "mock" (demo, datos de prueba) o "http" (API de Agentia).
VITE_DATA_SOURCE=mock

# URL base de la API de Agentia (solo cuando VITE_DATA_SOURCE=http). Sin barra final.
VITE_API_BASE_URL=

# Flujo de reservas:
#   "whatsapp" = abre WhatsApp con el mensaje listo y registra la solicitud en el backend en segundo plano.
#   "api"      = pide nombre y teléfono en la página, envía la solicitud al backend y muestra el estado.
VITE_RESERVATION_FLOW=whatsapp

# Número de WhatsApp en formato internacional sin "+" (ej. 52XXXXXXXXXX).
# Vacío = se usa el provisional 520000000000 (Número FICTICIO 52 000 000 0000: no existe, solo para la demo. PENDIENTE el real).
# PENDIENTE: poner el número oficial antes del lanzamiento.
VITE_WHATSAPP_NUMBER=

# URL pública del sitio (para metadatos sociales y canonical).
VITE_SITE_URL=https://labebesita.netlify.app
